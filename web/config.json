{
    "inputMode": "hand",
    "hands": {
        "left": "full",
        "right": "full",
        "modelComplexity": 1,
        "minDetectionConfidence": 0.3,
        "minTrackingConfidence": 0.3,
        "detectionHoldFrames": 3
    },
    "pipeline": "device_jacobi",
    "imagePath": "/img1.png",
    "window": {
        "baseSize": 900,
        "defaultWidth": 1200,
        "defaultHeight": 800
    },
    "simulation": {
        "resolution": 400,
        "timestep": 0.020,
        "edges": 14,
        "projection": {
            "overrelaxationCoefficient": 1.0,
            "iterations": 100
        },
        "vorticity": {
            "strength": 20.0,
            "lengthScale": 10.0
        },
        "windTunnel": {
            "side": 0,
            "startPosition": 0.475,
            "endPosition": 0.525,
            "velocity": 1
        },
        "circle": {
            "radius": 0.02,
            "momentumTransferStrength": 5,
            "momentumTransferRadius": 2.0,
            "handSensitivity": 0.3,
            "clearDensityOnVacate": true,
            "zScaling": {
                "zMin": -0.1,
                "zMax": 0.1,
                "zScaleMin": 2,
                "zScaleMax": 0.5
            }
        }
    },
    "render": {
        "preset": "default",
        "labelsEnabled": true,
        "buttonsEnabled": true,
        "camerasEnabled": true,
        "divergenceBinomialFiltering": true,
        "velocityScale": 0.01,
        "cameraBackgroundDensityExponent": 2,
        "components": {
            "camera_frame": {
                "x": 0, "y": 0.25, "w": 0.25, "h": 0.25,
                "px": 5, "py": 5
            },
            "viewport_1": {
                "x": 0.5, "y": 0.0, "w": 0.5, "h": 0.5,
                "px": 5, "py": 5,
                "viewportTarget": 0,
                "viewportCameraBackground": "current"
            },
            "viewport_2": {
                "x": 0.5, "y": 0.5, "w": 0.5, "h": 0.5,
                "px": 5, "py": 5,
                "viewportTarget": 2,
                "viewportCameraBackground": "none"
            },
            "viewport_3": {
                "x": 0.0, "y": 0.5, "w": 0.5, "h": 0.5,
                "px": 5, "py": 5,
                "viewportTarget": 0,
                "viewportCameraBackground": "none"
            },
            "viewport_4": {
                "x": 0.0, "y": 0.0, "w": 0.5, "h": 0.5,
                "px": 5, "py": 5,
                "viewportTarget": 1,
                "viewportCameraBackground": "none"
            },
            "density_histogram": {
                "x": 0.0, "y": 0.0, "w": 0.25, "h": 0.25,
                "px": 5, "py": 5,
                "histogramEnabled": true
            },
            "velocity_histogram": {
                "x": 0.25, "y": 0, "w": 0.25, "h": 0.25,
                "px": 5, "py": 5,
                "histogramEnabled": true
            },
            "entropy_time_series": {
                "x": 0.0, "y": 0.0, "w": 0.25, "h": 0.25,
                "px": 5, "py": 5,
                "histogramEnabled": true
            },
            "volume_time_series": {
                "x": 0.25, "y": 0.25, "w": 0.25, "h": 0.25,
                "px": 5, "py": 5,
                "histogramEnabled": false
            }
        }
    }
