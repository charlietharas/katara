{
    "pipeline": "hybrid",
    "window": {
        "baseSize": 800,
        "defaultWidth": 1200,
        "defaultHeight": 800
    },
    "simulation": {
        "resolution": 100,
        "timestep": 0.02,
        "gravity": -5,
        "fluidDensity": 1000.0,
        "edges": 15,
        "projection": {
            "overrelaxationCoefficient": 1.9,
            "iterations": 40
        },
        "vorticity": {
            "enabled": true,
            "strength": 10.0,
            "lengthScale": 5.0
        },
        "windTunnel": {
            "side": 0,
            "startPosition": 0.45,
            "endPosition": 0.55,
            "velocity": 2
        },
        "circle": {
            "radius": 0,
            "momentumTransferStrength": 1,
            "momentumTransferRadius": 2
        }
    },
    "rendering": {
        "target": 2,
        "showVelocityVectors": false,
        "velocityScale": 0.1,
        "disableHistograms": false
    },
    "ink": {
        "imagePath": "img1.png"
    }
}