{
    "pipeline": "device",
    "window": {
        "baseSize": 900,
        "defaultWidth": 1200,
        "defaultHeight": 800
    },
    "simulation": {
        "resolution": 600,
        "timestep": 0.02,
        "gravity": 0,
        "fluidDensity": 1000.0,
        "edges": 14,
        "projection": {
            "overrelaxationCoefficient": 1.0,
            "iterations": 200
        },
        "vorticity": {
            "enabled": true,
            "strength": 20.0,
            "lengthScale": 10.0
        },
        "windTunnel": {
            "side": 0,
            "startPosition": 0.45,
            "endPosition": 0.55,
            "velocity": 1
        },
        "circle": {
            "radius": 0.02,
            "momentumTransferStrength": 0.5,
            "momentumTransferRadius": 1
        }
    },
    "rendering": {
        "target": 2,
        "showVelocityVectors": false,
        "velocityScale": 0.1,
        "disableHistograms": false
    },
    "ink": {
        "imagePath": "/img1.png"
    }
}
