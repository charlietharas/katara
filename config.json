{
    "pipeline": "device",
    "window": {
        "baseSize": 900,
        "defaultWidth": 1200,
        "defaultHeight": 800
    },
    "simulation": {
        "resolution": 400,
        "timestep": 0.02,
        "gravity": 0,
        "fluidDensity": 1000.0,
        "edges": 15,
        "projection": {
            "overrelaxationCoefficient": 1.0,
            "iterations": 200
        },
        "vorticity": {
            "enabled": true,
            "strength": 20.0,
            "lengthScale": 10.0
        },
        "windTunnel": {
            "side": 0,
            "startPosition": 0.475,
            "endPosition": 0.525,
            "velocity": 0
        },
        "circle": {
            "radius": 0.02,
            "momentumTransferStrength": 10,
            "momentumTransferRadius": 2,
            "zScaling": {
                "zMin": -0.1,
                "zMax": 0.1,
                "scaleMin": 2,
                "scaleMax": 0.5
            }
        }
    },
    "rendering": {
        "target": 3,
        "showVelocityVectors": false,
        "velocityScale": 0.1,
        "disableHistograms": false
    },
    "ink": {
        "imagePath": "/img1.png"
    }
}
