{
    "pipeline": "device",
    "window": {
        "baseSize": 900,
        "defaultWidth": 1200,
        "defaultHeight": 800
    },
    "simulation": {
        "resolution": 400,
        "timestep": 0.02,
        "gravity": 0,
        "fluidDensity": 1000.0,
        "edges": 15,
        "projection": {
            "overrelaxationCoefficient": 1.0,
            "iterations": 200
        },
        "vorticity": {
            "enabled": true,
            "strength": 20.0,
            "lengthScale": 10.0
        },
        "windTunnel": {
            "side": 0,
            "startPosition": 0.475,
            "endPosition": 0.525,
            "velocity": 1
        },
        "circle": {
            "radius": 0.02,
            "momentumTransferStrength": 40,
            "momentumTransferRadius": 2.5,
            "zScaling": {
                "zMin": -0.1,
                "zMax": 0.1,
                "scaleMin": 2,
                "scaleMax": 0.5
            },
            "handSmoothingAlphaLow": 0.15,
            "handSmoothingAlphaHigh": 0.7,
            "handSpeedThreshold": 5.0,
            "momentumTransferDeadZone": 5.0
        }
    },
    "rendering": {
        "target": 3,
        "showVelocityVectors": false,
        "velocityScale": 0.04,
        "disableHistograms": false
    },
    "ink": {
        "imagePath": "/img1.png"
    },
    "layout": {
        "components": {
            "camera_frame": {
                "x": 0, "y": 0.25, "w": 0.25, "h": 0.25,
                "px": 5, "py": 5
            },
            "viewport_1": {
                "x": 0.5, "y": 0.0, "w": 0.5, "h": 0.5,
                "px": 5, "py": 5,
                "target": 2
            },
            "viewport_2": {
                "x": 0.5, "y": 0.5, "w": 0.5, "h": 0.5,
                "px": 5, "py": 5,
                "target": 3
            },
            "viewport_3": {
                "x": 0.0, "y": 0.5, "w": 0.5, "h": 0.5,
                "px": 5, "py": 5,
                "target": 0
            },
            "density_histogram": {
                "x": 0.0, "y": 0.0, "w": 0.25, "h": 0.25,
                "px": 5, "py": 5,
                "enabled": true
            },
            "velocity_histogram": {
                "x": 0.25, "y": 0, "w": 0.25, "h": 0.25,
                "px": 5, "py": 5,
                "enabled": true
            },
            "entropy_time_series": {
                "x": 0.0, "y": 0.0, "w": 0.25, "h": 0.25,
                "px": 5, "py": 5,
                "enabled": true
            }
        }
    }
}
